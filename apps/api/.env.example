# Database Configuration

# PostgreSQL connection string
# Format: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
DATABASE_URL=postgresql://ainvr:ainvr_dev@localhost:5432/ainvr

# Connection pool settings (optional - defaults shown)
# Maximum number of connections in the pool
DB_POOL_MAX=20

# Milliseconds to wait for a connection before timeout
DB_CONNECTION_TIMEOUT_MS=2000

# Milliseconds before closing idle connections
DB_IDLE_TIMEOUT_MS=30000

# Application environment
NODE_ENV=development

# API Server
API_PORT=3000
API_HOST=0.0.0.0

# Logging
LOG_LEVEL=debug

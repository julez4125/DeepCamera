{
  "name": "@ainvr/api",
  "version": "0.0.0",
  "description": "AI-NVR Platform - API Server",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "node --loader tsx ./src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^8.0.0",
    "fastify-plugin": "^5.0.0",
    "jose": "^5.0.0",
    "pg": "^8.11.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0",
    "@ainvr/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.0",
    "tsx": "^4.7.0",
    "vitest": "^1.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  }
}
